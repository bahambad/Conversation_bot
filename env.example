# Bot token
BOT_TOKEN = 'your_bot_token'
# Admin user id
ADMIN = 1234567890
# Privileged users: they get the features that are not open to everyone,
# e.g. turning videos into video notes (optional, comma separated ids)
# PRIVILEGED_USERS = 1234567890,987654321
# Sites allowed for downloading by link (optional, comma separated).
# If not set, the built-in list is used (the value below is that default).
# Setting it REPLACES the built-in list, it does not extend it.
# ALLOWED_DOMAINS = youtube.com,youtu.be,tiktok.com,instagram.com,twitter.com,x.com,vk.com,vkvideo.ru,rutube.ru,soundcloud.com,vimeo.com,twitch.tv
# Language model for the editor (optional): OpenRouter API key and a model id or preset
# OPENROUTER_API_KEY = your_openrouter_key
# LLM_MODEL = @preset/your-preset
# Stronger model used only when the main one fails (optional)
# LLM_ESCALATION_MODEL = anthropic/claude-sonnet-5.5
